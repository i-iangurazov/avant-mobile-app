EXPO_PUBLIC_APP_NAME=Авантехник
EXPO_PUBLIC_WHATSAPP_BUSINESS_PHONE=+996500991966
NEXT_PUBLIC_WHATSAPP_BUSINESS_PHONE=+996500991966
EXPO_PUBLIC_2GIS_SEARCH_URL=https://2gis.kg/bishkek/search/%D0%90%D0%B2%D0%B0%D0%BD%D1%82%D0%B5%D1%85%D0%BD%D0%B8%D0%BA
EXPO_PUBLIC_API_URL=https://api.example.invalid
EXPO_PUBLIC_IMAGE_SEARCH_ENABLED=false
# EXPO_PUBLIC_IMAGE_SEARCH_URL=https://your-vision-search-service.example.com/image-search
# EXPO_PUBLIC_DEBUG_API_ERRORS=false
# For local testing, Expo Go needs your computer LAN IP and Expo Web should use loopback:
# EXPO_PUBLIC_API_URL=http://192.168.68.107:8787
# EXPO_PUBLIC_API_URL_WEB=http://127.0.0.1:8787

# Current read-only product catalog source. Orders are never sent here.
BAZAAR_API_BASE_URL=https://www.bazaar.kg/api/bazaar/v1
BAZAAR_API_TOKEN=replace_with_real_token_from_env_only
APP_SERVER_PORT=8787

# App backend database/auth. Server-side only.
DATABASE_URL=postgres://avantehnik:avantehnik_dev_password@127.0.0.1:5438/avantehnik
AUTH_TOKEN_SECRET=replace_with_long_random_server_side_secret

# Telegram order operations. Server-side only; never prefix these with EXPO_PUBLIC_.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_admin_group_chat_id
# Public bot username without @; required only for a one-tap account-link URL.
# Without it, the app still shows a secure one-time /start command.
TELEGRAM_BOT_USERNAME=replace_with_bot_username

# Administrator roles are assigned by audited account-ID operations, never phone lists.
# Railway uses RAILWAY_PUBLIC_DOMAIN automatically. Set this on other hosts.
# TELEGRAM_WEBHOOK_URL=https://api.example.com/telegram/webhook
# Optional; otherwise the server derives a stable secret from other server secrets.
# TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret

# Registration/login use phone + password. Phone ownership is not inferred.
# Recovery requests are handled by an authorized support administrator.
# ADMIN_PHONE_NUMBERS is deprecated and NEVER grants access.

# Trusted order context. Populate approved branches/offers through the server-side inventory integration.
APP_ORGANIZATION_ID=
DELIVERY_BRANCH_ID=
# Leave blank until owner approves retention and erase-all semantics.
ACCOUNT_DELETION_MODE=
# Media adapter must decode images, strip metadata, enforce size limits and support idempotent deletion.
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_TOKEN=
MEDIA_PUBLIC_HOST=
