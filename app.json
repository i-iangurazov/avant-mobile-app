{
  "expo": {
    "name": "Авантехник",
    "slug": "avantehnik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/imports/avant-icon.png",
    "scheme": "avantehnik",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/imports/avant-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "src/imports/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kg.avantehnik.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Авантехник использует камеру для поиска товаров и прикрепления фото к заявке.",
        "NSPhotoLibraryUsageDescription": "Выберите фотографию товара или анкеты, которую хотите прикрепить."
      }
    },
    "android": {
      "package": "kg.avantehnik.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/imports/avant-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WRITE_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Выберите фотографию товара или анкеты, которую хотите прикрепить.",
          "cameraPermission": "Авантехник использует камеру для поиска товаров и прикрепления фото к заявке.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ]
  }
}
