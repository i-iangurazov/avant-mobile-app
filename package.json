{
  "name": "avantehnik-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "check:telegram": "tsx scripts/check-telegram.ts",
    "check:orders": "tsx scripts/check-orders.ts",
    "check:db": "tsx scripts/check-db.ts",
    "check:loyalty": "tsx scripts/check-loyalty.ts",
    "db:up": "docker compose up -d postgres",
    "dev:server": "tsx scripts/app-server.ts",
    "start:server": "tsx scripts/app-server.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "visual:auth": "node scripts/auth-flow-smoke.mjs",
    "visual:plumber": "node scripts/plumber-ui-smoke.mjs",
    "visual:back": "node scripts/back-button-smoke.mjs",
    "visual:cart": "node scripts/cart-flow-smoke.mjs",
    "smoke": "npm run typecheck && npm run lint && npm run check:db && npm run check:orders && npm run check:loyalty",
    "visual:order": "node scripts/order-detail-smoke.mjs",
    "check:remediation": "tsx scripts/tests/security.ts && tsx scripts/tests/orders.ts && tsx scripts/tests/loyalty.ts && tsx scripts/tests/deletion.ts && tsx scripts/tests/media.ts && tsx scripts/tests/catalog.ts && tsx scripts/tests/catalog-gateway.ts && tsx scripts/tests/reward-attempt.ts",
    "postinstall": "node scripts/build/patch-metro.cjs && node scripts/build/patch-expo-activity.cjs && node scripts/build/patch-screens-density.cjs",
    "eas-build-pre-install": "node scripts/build/verify-env.cjs",
    "check:release-env": "node scripts/build/verify-env.cjs --required",
    "check:telegram-orders": "tsx scripts/tests/telegram-orders.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~54.0.35",
    "expo-brightness": "~14.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "tsx": "^4.23.0",
    "zustand": "^5.0.8",
    "expo-system-ui": "~6.0.9"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "postcss": "8.5.28",
    "react-dom": "19.1.0",
    "react-server-dom-webpack": "19.1.5",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0",
    "image-size": "2.0.4"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13 <23"
  }
}
